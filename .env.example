# Copy this file to .env.local (for running on your computer) and add the same
# values in Vercel → Project → Settings → Environment Variables.
#
# These are SERVER-ONLY. Do not rename them with a NEXT_PUBLIC_ prefix —
# that would expose the secret key to every visitor's browser.

# Supabase → Project Settings → API (or "Data API") → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → "secret" key (sb_secret_...)
# (older projects: the "service_role" key). Keep this private.
SUPABASE_SECRET_KEY=

# Any long random string. Used to hash IP addresses for rate limiting.
WISHES_IP_SALT=change-me-to-something-long-and-random

# "true"  = new wishes stay hidden until you tick `approved` in Supabase.
# "false" = wishes appear on the site immediately (still rate limited).
WISHES_REQUIRE_APPROVAL=false
